# ===== Docling Serve 连接配置 =====
# 指向 Docling Serve 的 REST API 根地址（不是 /ui/ 那个 Gradio 界面！）
# 同一进程同时提供：REST API 在 http://host:port/v1/...  和  Gradio UI 在 http://host:port/ui/
# 本系统对接的是 REST API，所以只填到端口，不要带 /ui/ 后缀。
# 示例（你贴的那台机器）：
DOCLING_BASE_URL=http://10.0.0.22:5001

# 说明：表格识别模式（docling_table_mode）与轮询间隔（poll_interval_seconds）
# 不是环境变量，而是运行时设置，存于数据库，默认值分别为 accurate 与 2。
# 容器首次启动会由数据库自动播种这些默认值，之后可在前端「设置」页修改。

# ===== 大模型（LLM）配置 =====
# OpenAI 兼容 API。填你自己的 Key。
LLM_API_KEY=your-api-key-here
# API 基址，换成你用的服务商（DeepSeek / 智谱 / 混元 等把 /v1 补全即可）。
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ===== 本地存储 =====
DATABASE_PATH=./data/docling_webui.db
UPLOAD_DIR=./uploads

# ===== 上传限制 =====
MAX_FILE_SIZE_MB=50
MAX_ZIP_SIZE_MB=200
MAX_FILES_PER_BATCH=500

# ===== 服务监听 =====
HOST=0.0.0.0
PORT=8000
