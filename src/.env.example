# ===== Docling Serve 连接配置 =====
# 指向 Docling Serve 的 REST API 根地址（不是 /ui/ 那个 Gradio 界面！）
# 同一进程同时提供：REST API 在 http://host:port/v1/...  和  Gradio UI 在 http://host:port/ui/
# 本系统对接的是 REST API，所以只填到端口，不要带 /ui/ 后缀。
# compose 内部默认用服务名 http://docling-serve:5001；
# 本地独立运行（非 compose）请改为 http://localhost:5001。
DOCLING_BASE_URL=http://docling-serve:5001

# 说明：表格识别模式（docling_table_mode）与轮询间隔（poll_interval_seconds）
# 不是环境变量，而是运行时设置，存于数据库，默认值分别为 accurate 与 2。
# 容器首次启动会由数据库自动播种这些默认值，之后可在前端「设置」页修改。

# ===== 大模型（LLM）配置 =====
# OpenAI 兼容 API。填你自己的 Key。
LLM_API_KEY=your-api-key-here
# API 基址，换成你用的服务商（DeepSeek / 智谱 / 混元 等把 /v1 补全即可）；
# 本地用 Ollama 则填 http://localhost:11434/v1（详见 README「用本地大模型（Ollama）」）。
LLM_BASE_URL=https://api.openai.com/v1
# 模型名；本地 Ollama 可填 lukey03/qwen3.5-9b-abliterated:latest（Ollama 拉取后使用）。
LLM_MODEL=gpt-4o-mini
# LLM 调用超时（秒）。本地/较慢模型（如 Ollama 跑 9B 模型生成大表）很慢，默认 600s；
# 若仍报超时，请调大此值（也可在设置里存 llm_timeout，或环境变量 LLM_TIMEOUT）。
LLM_TIMEOUT=600

# ===== 本地存储 =====
DATABASE_PATH=./data/docling_webui.db
UPLOAD_DIR=./uploads

# ===== 上传限制 =====
MAX_FILE_SIZE_MB=50
MAX_ZIP_SIZE_MB=200
MAX_FILES_PER_BATCH=500

# ===== 服务监听 =====
HOST=0.0.0.0
PORT=8000
